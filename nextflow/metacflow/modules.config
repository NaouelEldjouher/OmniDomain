// MetaCflow — process configuration
// Included via nextflow.config: includeConfig 'metacflow/modules.config'

process {

    // ── QC ────────────────────────────────────────────────────────────────────
    withName: '.*FASTP.*' {
        container  = 'quay.io/biocontainers/fastp:0.23.4--hadf994f_2'
        ext.args   = '--detect_adapter_for_pe --qualified_quality_phred 20 --length_required 50'
        publishDir = [ path: { "${params.base_outdir}/metacflow/${params.sample_id}/01_qc/fastp" }, mode: 'copy' ]
    }
    withName: '.*FILTLONG.*' {
        container  = 'quay.io/biocontainers/filtlong:0.2.1--h9a82719_0'
        ext.args   = '--min_length 1000 --keep_percent 95'
        ext.prefix = { "filtered" }
        publishDir = [ path: { "${params.base_outdir}/metacflow/${params.sample_id}/01_qc/filtlong" }, mode: 'copy' ]
    }
    withName: '.*NANOPLOT.*' {
        container  = 'quay.io/biocontainers/nanoplot:1.42.0--pyhdfd78af_0'
        publishDir = [ path: { "${params.base_outdir}/metacflow/${params.sample_id}/01_qc/nanoplot" }, mode: 'copy' ]
    }

    // ── ASSEMBLY ──────────────────────────────────────────────────────────────
    withName: '.*MEGAHIT.*' {
        container  = 'quay.io/biocontainers/megahit:1.2.9--h43eeafb_4'
        cpus       = { check_max( 8,                    'cpus'   ) }
        memory     = { check_max( 16.GB * task.attempt, 'memory' ) }
        publishDir = [ path: { "${params.base_outdir}/metacflow/${params.sample_id}/02_assembly/megahit" }, mode: 'copy' ]
    }
    withName: '.*FLYE.*' {
        container  = 'quay.io/biocontainers/flye:2.9.3--py310h2b6aa90_0'
        cpus       = { check_max( 8,                    'cpus'   ) }
        memory     = { check_max( 16.GB * task.attempt, 'memory' ) }
        ext.args   = '--meta'
        publishDir = [ path: { "${params.base_outdir}/metacflow/${params.sample_id}/02_assembly/flye" }, mode: 'copy' ]
    }
    withName: '.*SPADES.*' {
        container  = 'staphb/spades:4.0.0'
        cpus       = { check_max( 8,                    'cpus'   ) }
        memory     = { check_max( 16.GB * task.attempt, 'memory' ) }
        ext.args   = '--meta'
        publishDir = [ path: { "${params.base_outdir}/metacflow/${params.sample_id}/02_assembly/spades" }, mode: 'copy' ]
    }

    // ── BINNING ───────────────────────────────────────────────────────────────
    withName: '.*MINIMAP2_ALIGN.*' {
        container  = 'staphb/minimap2:2.28'
        publishDir = [ path: { "${params.base_outdir}/metacflow/${params.sample_id}/03_binning/coverage" }, mode: 'copy', saveAs: { null } ]
    }
    withName: '.*METABAT2.*' {
        container  = 'quay.io/biocontainers/metabat2:2.17--hd498684_0'
        publishDir = [ path: { "${params.base_outdir}/metacflow/${params.sample_id}/03_binning/metabat2" }, mode: 'copy' ]
    }
    withName: '.*CHECKM2.*' {
        container  = 'quay.io/biocontainers/checkm2:1.0.1--pyh7cba7a3_0'
        cpus       = { check_max( 8,                    'cpus'   ) }
        memory     = { check_max( 16.GB * task.attempt, 'memory' ) }
        publishDir = [ path: { "${params.base_outdir}/metacflow/${params.sample_id}/04_bin_qc/checkm2" }, mode: 'copy' ]
    }

    // ── ANNOTATION ────────────────────────────────────────────────────────────
    withName: '.*PROKKA.*' {
        container  = 'quay.io/biocontainers/prokka:1.14.6--pl5321hdfd78af_4'
        cpus       = { check_max( 4,                    'cpus'   ) }
        memory     = { check_max( 8.GB  * task.attempt, 'memory' ) }
        publishDir = [ path: { "${params.base_outdir}/metacflow/${params.sample_id}/05_annotation/prokka" }, mode: 'copy' ]
    }

    // ── AMR ───────────────────────────────────────────────────────────────────
    withName: '.*RESFINDER.*' {
        container  = 'quay.io/biocontainers/resfinder:4.3.2--pyhdfd78af_0'
        publishDir = [ path: { "${params.base_outdir}/metacflow/${params.sample_id}/06_amr/resfinder" }, mode: 'copy' ]
    }
}

    // ── TAXONOMY ──────────────────────────────────────────────────────────────
    withName: 'TAXONOMY:KRAKEN2' {
        container  = 'staphb/kraken2:latest'
        cpus       = { check_max( 8,                    'cpus'   ) }
        memory     = { check_max( 16.GB * task.attempt, 'memory' ) }
        publishDir = [ path: { "${params.base_outdir}/metacflow/${params.sample_id}/05_taxonomy/kraken2" }, mode: 'copy' ]
    }
    withName: 'TAXONOMY:BRACKEN' {
        container  = 'quay.io/biocontainers/bracken:2.9--py310h0dbaff4_0'
        ext.args   = '-l S -t 10'
        publishDir = [ path: { "${params.base_outdir}/metacflow/${params.sample_id}/05_taxonomy/bracken" }, mode: 'copy' ]
    }
