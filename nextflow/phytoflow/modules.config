
// PhtyoFlow — HiFi plant genome assembly, annotation & comparative genomics
// Included via nextflow.config: includeConfig 'nextflow/phytoflow/modules.config'
 
params {
    pipeline_name      = 'OmniBio: phytoflow'

 
    // ── Inputs ────────────────────────────────────────────────────────────
    hifi_reads         = null              // mandatory — PacBio HiFi .fastq.gz
    hic_reads          = null              // optional — Hi-C for YAHS scaffolding
    hic_map            = null              // optional — Hi-C BAM for YAHS
    reference          = null              // optional — reference for RagTag
    transcriptome      = null              // optional — RNA-seq for MAKER
    proteins           = null              // optional — protein hints for MAKER
 
    // ── Annotation flags ──────────────────────────────────────────────────
    run_helixer        = false
    run_maker          = false
    run_comparative    = false
 
    // ── Databases ─────────────────────────────────────────────────────────
    // null = tool downloads at runtime (slow on AWS — pre-download recommended)
    helixer_models_dir = null
    busco_db           = null
    eggnog_db_dir = '/home/naoue/databases/eggnog'             // parameterised — not hardcoded path
 
    // ── NLR-Annotator assets ───────────────────────────────────────────────
    nlr_jar   = "${projectDir}/assets/nlr-annotator/NLR-Annotator-v2.1b.jar"
    nlr_mot   = "${projectDir}/assets/nlr-annotator/mot.txt"
    nlr_store = "${projectDir}/assets/nlr-annotator/store.txt"
 
    // ── Output ────────────────────────────────────────────────────────────
    outdir             = 'results/phytoflow'
}
 
process {
 
    // ==========================================================================
    // PHASE 1 — QC (HiFi-specific)
    // ==========================================================================
    withName: '.*HIFIADAPTERFILT.*' {
        container  = 'quay.io/biocontainers/hifiadapterfilt:3.0.0--hdfd78af_0'
        ext.args   = '-l 20 -m 85'
        publishDir = [ path: { "${params.outdir}/01_qc/hifiadapterfilt/${meta.id}" }, mode: 'copy' ]
    }
    withName: '.*SEQKIT.*' {
        container  = 'quay.io/biocontainers/seqkit:2.9.0--h9ee0642_0'
        publishDir = [ path: { "${params.outdir}/01_qc/seqkit_stats/${meta.id}" }, mode: 'copy' ]
    }
 
    // ==========================================================================
    // PHASE 2 — Assembly
    // ==========================================================================
    withName: '.*HIFIASM.*' {
        container  = 'quay.io/biocontainers/hifiasm:0.19.8--h43eeafb_0'
        cpus       = 4
        memory     = { check_max( 16.GB * task.attempt, 'memory' ) }
        publishDir = [ path: { "${params.outdir}/02_assembly/hifiasm/${meta.id}" }, mode: 'copy' ]
    }
    withName: '.*GFA_TO_FASTA.*' {
        publishDir = [ path: { "${params.outdir}/02_assembly/fasta/${meta.id}" }, mode: 'copy' ]
    }
 
    // ==========================================================================
    // PHASE 3 — Assembly QC
    // ==========================================================================
    withName: '.*QUAST.*' {
        container  = 'community.wave.seqera.io/library/quast:5.3.0--755a216045b6dbdd'
        publishDir = [ path: { "${params.outdir}/03_assembly_qc/quast/${meta.id}" }, mode: 'copy' ]
    }
    withName: '.*BUSCO.*' {
        container  = 'ezlabgva/busco:v5.8.0_cv1'
        publishDir = [ path: { "${params.outdir}/03_assembly_qc/busco/${meta.id}" }, mode: 'copy' ]
    }
    withName: '.*MINIMAP2_ALIGN.*' {
        container  = 'staphb/minimap2:2.28'
        publishDir = [ path: { "${params.outdir}/03_assembly_qc/coverage/${meta.id}" }, mode: 'copy',
                       pattern: '*.sam', saveAs: { null } ]  // SAM too large — don't save
    }
    withName: '.*SAMTOOLS_COVERAGE.*' {
        container  = 'staphb/samtools:1.21'
        publishDir = [ path: { "${params.outdir}/03_assembly_qc/coverage/${meta.id}" }, mode: 'copy' ]
    }
 
    // ==========================================================================
    // PHASE 4 — Scaffolding (nuclear mode only)
    // ==========================================================================
    withName: '.*YAHS.*' {
        container  = 'quay.io/biocontainers/yahs:1.2a.2--h3e00fc2_2'
        publishDir = [ path: { "${params.outdir}/04_scaffolding/yahs/${meta.id}" }, mode: 'copy' ]
    }
    withName: '.*RAGTAG.*' {
        container  = 'quay.io/biocontainers/ragtag:2.1.0--pyhdfd78af_1'
        publishDir = [ path: { "${params.outdir}/04_scaffolding/ragtag/${meta.id}" }, mode: 'copy' ]
    }
 
    // ==========================================================================
    // PHASE 5 — Repeat masking
    // ==========================================================================
    withName: '.*REPEATMODELER.*' {
        container  = 'quay.io/biocontainers/repeatmodeler:2.0.5--pl5321hdfd78af_0'
        publishDir = [ path: { "${params.outdir}/05_repeat_masking/repeatmodeler/${meta.id}" }, mode: 'copy' ]
    }
    withName: '.*REPEATMASKER.*' {
        container  = 'quay.io/biocontainers/repeatmasker:4.1.5--pl5321hdfd78af_0'
        publishDir = [ path: { "${params.outdir}/05_repeat_masking/repeatmasker/${meta.id}" }, mode: 'copy' ]
    }
    withName: '.*EXTRACT_PROTEOME.*' {
    container = 'quay.io/biocontainers/agat:1.4.0--pl5321hdfd78af_0'}
 
    // ==========================================================================
    // PHASE 6 — Structural annotation (nuclear mode only)
    // ==========================================================================
    withName: '.*HELIXER.*' {
        container        = 'docker.io/gglyptodon/helixer-docker:helixer_v0.3.3_cuda_11.8.0-cudnn8'
        containerOptions = { params.helixer_models_dir
        ? "-v ${params.helixer_models_dir}:/home/helixer_user/.local/share/Helixer/models"
        : '' }
        ext.args         = '--lineage land_plant --species plant'
        publishDir       = [ path: { "${params.outdir}/06_annotation/helixer" }, mode: 'copy' ]
    }
    withName: '.*BRAKER3.*' {
        container  = 'docker.io/teambraker/braker3:latest'
        publishDir = [ path: { "${params.outdir}/06_annotation/braker3" }, mode: 'copy' ]
    }
 
    // ==========================================================================
    // PHASE 7 — Secondary metabolites & defense (nuclear mode only)
    // ==========================================================================
    withName: '.*NLR_ANNOTATOR.*' {
        container  = 'eclipse-temurin:11-jre-jammy'
        publishDir = [ path: { "${params.outdir}/07_secondary/nlr_annotator/${meta.id}" }, mode: 'copy' ]
    }
 
    // ==========================================================================
    // PHASE 8 — Functional annotation (nuclear mode only)
    // ==========================================================================
    withName: '.*EGGNOG.*' {
        container        = 'quay.io/biocontainers/eggnog-mapper:2.1.12--pyhdfd78af_0'
        containerOptions = { params.eggnog_db_dir
        ? "-v ${params.eggnog_db_dir}:/eggnog_db"
        : '' }
        ext.args  = '--no_file_comments'  // removed --no_annot — real DB available
    }
    withName: '.*PLANTTFDB.*' {
        container  = 'quay.io/biocontainers/hmmer:3.4--hdbdd923_1'
        publishDir = [ path: { "${params.outdir}/08_functional/planttfdb" }, mode: 'copy' ]
    }
 
    // ==========================================================================
    // PHASE 9 — Comparative genomics (multi-sample, optional)
    // ==========================================================================
    withName: '.*ORTHOFINDER.*' {
        container  = 'davidemms/orthofinder:2.5.5'
        publishDir = [ path: { "${params.outdir}/09_comparative/orthofinder/${meta.id}" }, mode: 'copy' ]
    }
    withName: '.*MCSCANX.*' {
        container  = 'quay.io/biocontainers/mcscanx:2012.11.11--h9a82719_1'
        publishDir = [ path: { "${params.outdir}/09_comparative/mcscanx/${meta.id}" }, mode: 'copy' ]
    }
}
 