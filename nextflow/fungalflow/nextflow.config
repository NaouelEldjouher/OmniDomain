// fungalflow/modules.config

params {
    pipeline_name      = 'OmniBio: FungalFlow'
    genome_type        = 'nuclear'  
    
    // Inputs
    shortreads         = null
    longreads          = null
    rnaseq_bam         = null
    
    // Outputs (Updated to match your exact request)
    outdir             = 'output/fungalflow'
    
    // Databases
    busco_db           = null
    protein_hints      = null
    eggnog_db          = '/home/naoue/databases/eggnog'
}

process {
    // ==============================================================================
    // PHASE 1: QC
    // ==============================================================================
    withName: '.*FASTP.*' {
        container  = 'staphb/fastp:0.23.4'
        publishDir = [ path: { "${params.outdir}/fastp/${meta.id}" }, mode: 'copy' ]
    }
    withName: '.*FILTLONG.*' {
        container  = 'staphb/filtlong:0.2.1'
        publishDir = [ path: { "${params.outdir}/filtlong/${meta.id}" }, mode: 'copy' ]
    }
    withName: '.*NANOPLOT.*' {
        publishDir = [ path: { "${params.outdir}/nanoplot/${meta.id}" }, mode: 'copy' ]
    }

    // ==============================================================================
    // PHASE 2 & 3: ASSEMBLY & VALIDATION
    // ==============================================================================
    withName: '.*HIFIASM.*' {
        container  = 'quay.io/biocontainers/hifiasm:0.19.8--h43eeafb_0'
        cpus       = 4
        memory     = { check_max( 8.GB * task.attempt, 'memory' ) }
        publishDir = [ path: { "${params.outdir}/hifiasm/${meta.id}" }, mode: 'copy' ]
    }
    withName: '.*UNICYCLER.*' {
        publishDir = [ path: { "${params.outdir}/unicycler/${meta.id}" }, mode: 'copy' ]
    }
    withName: '.*QUAST.*' {
        publishDir = [ path: { "${params.outdir}/quast/${meta.id}" }, mode: 'copy' ]
    }
    withName: '.*BUSCO.*' {
        publishDir = [ path: { "${params.outdir}/busco/${meta.id}" }, mode: 'copy' ]
    }

    // ==============================================================================
    // PHASE 4: REPEAT MASKING
    // ==============================================================================
    withName: '.*REPEATMODELER.*' {
        container  = 'quay.io/biocontainers/repeatmodeler:2.0.5--pl5321hdfd78af_0'
        publishDir = [ path: { "${params.outdir}/repeatmodeler/${meta.id}" }, mode: 'copy' ]
    }
    withName: '.*REPEATMASKER.*' {
        container  = 'quay.io/biocontainers/repeatmasker:4.1.5--pl5321hdfd78af_0'
        publishDir = [ path: { "${params.outdir}/repeatmasker/${meta.id}" }, mode: 'copy' ]
    }

    // ==============================================================================
    // PHASE 5: STRUCTURAL ANNOTATION
    // ==============================================================================
    withName: '.*BRAKER3.*' {
        publishDir = [ path: { "${params.outdir}/braker3/${meta.id}" }, mode: 'copy', pattern: '*.*' ]
    }
    withName: '.*FUNANNOTATE.*' {
        publishDir = [ path: { "${params.outdir}/funannotate/${meta.id}" }, mode: 'copy', pattern: '*.*' ]
    }

    // ==============================================================================
    // PHASE 6: FUNCTIONAL & SECRETOME
    // ==============================================================================
    withName: '.*EGGNOG.*' {
        container        = 'quay.io/biocontainers/eggnog-mapper:2.1.12--pyhdfd78af_0'
        containerOptions = '-v /home/naoue/databases/eggnog:/eggnog_db'
        publishDir       = [ path: { "${params.outdir}/eggnog/${meta.id}" }, mode: 'copy' ]
    }
    withName: '.*DBCAN.*' {
        publishDir = [ path: { "${params.outdir}/dbcan/${meta.id}" }, mode: 'copy' ]
    }
    withName: '.*SIGNALP.*' {
        publishDir = [ path: { "${params.outdir}/signalp/${meta.id}" }, mode: 'copy' ]
    }
}