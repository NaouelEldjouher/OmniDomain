// fungalflow/modules.config

process {
    // ==============================================================================
    // PHASE 1: QC
    // ==============================================================================
    withName: '.*FASTP.*' {
        container  = 'staphb/fastp:0.23.4'
        ext.args   = '--detect_adapter_for_pe --qualified_quality_phred 20 --length_required 50'
        publishDir = [ path: { "${params.outdir}/fastp/${meta.id}" }, mode: 'copy' ]
    }
    withName: '.*FILTLONG.*' {
        container  = 'staphb/filtlong:0.2.1'
         ext.args   = '--min_length 1000 --keep_percent 95'
        publishDir = [ path: { "${params.outdir}/filtlong/${meta.id}" }, mode: 'copy' ]
    }
    withName: '.*NANOPLOT.*' {
        publishDir = [ path: { "${params.outdir}/nanoplot/${meta.id}" }, mode: 'copy' ]
    }
      // ==========================================================================
        // PHASE 2 — Assembly
        // ==========================================================================

        // SPAdes — Illumina short reads or hybrid assembly
        withName: '.*SPADES.*' {
            container  = 'staphb/spades:4.0.0'
            cpus       = { check_max( 8,                     'cpus'   ) }
            memory     = { check_max( 16.GB * task.attempt,  'memory' ) }
            time       = { check_max( 48.h  * task.attempt,  'time'   ) }
            publishDir = [ path: { "${params.outdir}/02_assembly/spades" }, mode: 'copy' ]
        }

        // Flye — ONT long reads
        withName: '.*FLYE.*' {
            container  = 'quay.io/biocontainers/flye:2.9.3--py310h2b6aa90_0'
            cpus       = { check_max( 8,                     'cpus'   ) }
            memory     = { check_max( 32.GB * task.attempt,  'memory' ) }
            time       = { check_max( 72.h  * task.attempt,  'time'   ) }
            publishDir = [ path: { "${params.outdir}/02_assembly/flye" }, mode: 'copy' ]
        }

        // Unicycler — hybrid assembly alternative (Illumina + ONT polish)
        withName: '.*UNICYCLER.*' {
            container  = 'quay.io/biocontainers/unicycler:0.5.0--py310h590eda1_3'
            cpus       = { check_max( 8,                     'cpus'   ) }
            memory     = { check_max( 32.GB * task.attempt,  'memory' ) }
            time       = { check_max( 72.h  * task.attempt,  'time'   ) }
            publishDir = [ path: { "${params.outdir}/02_assembly/unicycler" }, mode: 'copy' ]
        }

       // ==========================================================================
       // PHASE 3 — Assembly QC
       // =============================================================================================================
     withName: '.*QUAST.*' {
            container  = 'community.wave.seqera.io/library/quast:5.3.0--755a216045b6dbdd'
            publishDir = [ path: { "${params.outdir}/03_assembly_qc/quast" }, mode: 'copy' ]
     }
     withName: '.*BUSCO.*' {
            container  = 'ezlabgva/busco:v5.8.0_cv1'
            ext.args  = '--lineage fungi_odb10 --mode genome'
            publishDir = [ path: { "${params.outdir}/03_assembly_qc/busco" }, mode: 'copy' ]
     }

    // ==============================================================================
    // PHASE 4: REPEAT MASKING
    // ==============================================================================
     withName: '.*REPEATMODELER.*' {
            container  = 'quay.io/biocontainers/repeatmodeler:2.0.5--pl5321hdfd78af_0'
            cpus       = { check_max( 8,                     'cpus'   ) }
            memory     = { check_max( 32.GB * task.attempt,  'memory' ) }
            publishDir = [ path: { "${params.outdir}/04_repeat_masking/repeatmodeler" }, mode: 'copy' ]
     }
    withName: '.*REPEATMASKER.*' {
        container  = 'quay.io/biocontainers/repeatmasker:4.1.5--pl5321hdfd78af_0'
        cpus       = { check_max( 8,                     'cpus'   )}
        memory     = { check_max( 16.GB * task.attempt,  'memory' )}
        publishDir = [ path: { "${params.outdir}/repeatmasker/${meta.id}" }, mode: 'copy' ]
    }

    //    // ==========================================================================
          // PHASE 5 — Structural Annotation
          // ==========================================================================

          // Funannotate — all-in-one fungal annotation (short reads / hybrid mode)
          // Wraps Augustus, EVidenceModeler, tRNAscan-SE, InterProScan
          withName: '.*FUNANNOTATE.*' {
              container  = 'nextflowio/funannotate:latest'
              cpus       = { check_max( 8,                     'cpus'   ) }
              memory     = { check_max( 32.GB * task.attempt,  'memory' ) }
              time       = { check_max( 72.h  * task.attempt,  'time'   ) }
              publishDir = [ path: { "${params.outdir}/05_annotation/funannotate" }, mode: 'copy' ]
          }

          // BRAKER3 — evidence-based gene prediction (long reads / ONT mode)
          withName: '.*BRAKER3.*' {
              container  = 'docker.io/teambraker/braker3:latest'
              cpus       = { check_max( 8,                     'cpus'   ) }
              memory     = { check_max( 32.GB * task.attempt,  'memory' ) }
              time       = { check_max( 72.h  * task.attempt,  'time'   ) }
              publishDir = [ path: { "${params.outdir}/05_annotation/braker3" }, mode: 'copy' ]
          }
      withName: '.*ANTISMASH.*' {
          container  = 'docker.io/antismash/standalone:7.1.0'
          ext.args   = '--taxon fungi'
          publishDir = [ path: { "${params.outdir}/09_biosynthesis/antismash" }, mode: 'copy' ]
      }
        // ==========================================================================
        // PHASE 7 — Functional Annotation
        // ==========================================================================
    withName: '.*EGGNOG.*' {
        container        = 'quay.io/biocontainers/eggnog-mapper:2.1.12--pyhdfd78af_0'
        containerOptions = '-v /home/naoue/databases/eggnog:/eggnog_db'
        publishDir       = [ path: { "${params.outdir}/eggnog/${meta.id}" }, mode: 'copy' ]
    }
    withName: '.*DBCAN.*' {
        publishDir = [ path: { "${params.outdir}/dbcan/${meta.id}" }, mode: 'copy' ]
    }
    // ── J. SECRETOME PREDICTION ──────────────────────────────────────────────
    withName: '.*PHOBIUS.*' {
        container  = 'quay.io/biocontainers/phobius:101--hdfd78af_3'
        publishDir = [ path: { "${params.outdir}/08_secretome/phobius" }, mode: 'copy' ]
    }

    // ==========================================================================
    // PHASE 8 — Comparative Genomics (optional, --run_comparative true)
    // ==========================================================================

    withName: '.*ORTHOFINDER.*' {
        container  = 'davidemms/orthofinder:2.5.5'
        cpus       = { check_max( 8,                     'cpus'   ) }
        memory     = { check_max( 32.GB * task.attempt,  'memory' ) }
        publishDir = [ path: { "${params.outdir}/09_comparative/orthofinder" }, mode: 'copy' ]
    }

    withName: '.*IQTREE2.*' {
        container  = 'quay.io/biocontainers/iqtree:2.3.6--hdbdd923_0'
        publishDir = [ path: { "${params.outdir}/09_comparative/iqtree2" }, mode: 'copy' ]
    }

    withName: '.*CAFE5.*' {
        container  = 'quay.io/biocontainers/cafe:5.0.0--h031d066_2'
        publishDir = [ path: { "${params.outdir}/09_comparative/cafe5" }, mode: 'copy' ]
    }
}