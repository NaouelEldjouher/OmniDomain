// fungalflow/conf/modules.config

process {
    // --- Phase 1: Quality Control Outputs ---
    withName: 'FASTP' {
        publishDir = [ path: { "${params.outdir}/00_qc/shortreads" }, mode: 'copy' ]
    }
    
    withName: 'FILTLONG|NANOPLOT' {
        publishDir = [ path: { "${params.outdir}/00_qc/longreads" }, mode: 'copy' ]
    }

    // --- Phase 2: Genome Assembly ---
    withName: 'HIFIASM|UNICYCLER' {
        publishDir = [ path: { "${params.outdir}/01_assembly/draft" }, mode: 'copy' ]
    }

    // --- Phase 3: Assembly Validation Metrics ---
    withName: 'QUAST|BUSCO' {
        publishDir = [ path: { "${params.outdir}/01_assembly/validation" }, mode: 'copy' ]
    }

    // --- Phase 4: Repeat Masking Track ---
    withName: 'REPEATMODELER' {
        publishDir = [ path: { "${params.outdir}/01_assembly/repeats/library" }, mode: 'copy' ]
    }

    withName: 'REPEATMASKER' {
        publishDir = [ path: { "${params.outdir}/01_assembly/repeats/masked" }, mode: 'copy' ]
    }

    // --- Phase 5F: Structural Gene Annotation ---
    // FIXED: Broadened pattern parsing so multi-extension eukaryotic headers copy out reliably
    withName: 'BRAKER3|FUNANNOTATE' {
        publishDir = [ 
            path: { "${params.outdir}/02_structural_annotation" }, 
            mode: 'copy', 
            pattern: '*.*' 
        ]
    }

    // --- Phase 6F: Functional Annotation Profiling ---
    withName: 'EGGNOG|DBCAN' {
        publishDir = [ path: { "${params.outdir}/03_functional_annotation" }, mode: 'copy' ]
    }

    // --- Phase 6F (Cont): Secretome Pipeline ---
    withName: 'SIGNALP' {
        publishDir = [ path: { "${params.outdir}/04_secretome" }, mode: 'copy' ]
    }
}