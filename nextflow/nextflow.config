// OmniDomain/nextflow/nextflow.config
// Global configuration — applies to all pipelines
nextflow.enable.strict = false

manifest {
    name            = 'OmniDomain'
    author          = 'Naouel El Djouher'
    description     = 'Multi-kingdom genomics platform'
    nextflowVersion = '!>=23.04.0'
    version         = '1.0.0'
    homePage        = 'https://github.com/NaouelEldjouher/OmniDomain'
}

params {

    max_memory = '128.GB'
    max_cpus   = 32
    max_time   = '240.h'

    base_outdir = 'results'
    sample_id   = null

    genome_type     = 'organelle'
    run_comparative = false
    run_helixer     = false
    run_maker       = false

    shortreads    = null
    shortreads_r1 = null            // AWS Batch S3 URI mode
    shortreads_r2 = null
    longreads     = null
    rnaseq_bam    = null
    protein_hints = null

    hifi_reads         = null
    hic_reads          = null
    hic_map            = null
    reference          = null
    transcriptome      = null
    proteins           = null
    helixer_models_dir = null

    nlr_jar   = null
    nlr_mot   = null
    nlr_store = null

    eggnog_db_dir  = null
    busco_db_path  = null
    funannotate_db = null
    dbcan_db       = null
    resfinder_db   = null
    pointfinder_db = null
    checkm2_db     = null

    busco_lineage = 'fungi_odb10'

}

process {
    shell = ['/bin/bash', '-eo', 'pipefail']

    withLabel: 'process_single' {
        cpus   = { check_max( 1,                    'cpus'   ) }
        memory = { check_max( 2.GB  * task.attempt, 'memory' ) }
        time   = { check_max( 4.h   * task.attempt, 'time'   ) }
    }
    withLabel: 'process_low' {
        cpus   = { check_max( 2,                    'cpus'   ) }
        memory = { check_max( 4.GB  * task.attempt, 'memory' ) }
        time   = { check_max( 8.h   * task.attempt, 'time'   ) }
    }
    withLabel: 'process_medium' {
        cpus   = { check_max( 4,                    'cpus'   ) }
        memory = { check_max( 8.GB  * task.attempt, 'memory' ) }
        time   = { check_max( 24.h  * task.attempt, 'time'   ) }
    }
    withLabel: 'process_high' {
        cpus   = { check_max( 8,                    'cpus'   ) }
        memory = { check_max( 16.GB * task.attempt, 'memory' ) }
        time   = { check_max( 72.h  * task.attempt, 'time'   ) }
    }
    withLabel: 'process_very_high' {
        cpus   = { check_max( 16,                   'cpus'   ) }
        memory = { check_max( 64.GB * task.attempt, 'memory' ) }
        time   = { check_max( 120.h * task.attempt, 'time'   ) }
    }

    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries    = 2
}

profiles {

    docker {
        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g)'
        singularity.enabled = false
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }

    eukaryote_env {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        includeConfig 'phytoflow/modules.config'
    }

    fungal_env {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        includeConfig 'fungalflow/modules.config'
    }

    metacflow {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        includeConfig 'metacflow/modules.config'
    }

    staphb_amr {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        includeConfig 'nextamr/modules.config'
    }

    local_dev {
        params.max_memory = '20.GB'
        params.max_cpus   = 8
        params.max_time   = '24.h'
    }

    aws {
        params.max_memory  = '256.GB'
        params.max_cpus    = 64
        params.max_time    = '720.h'
        params.base_outdir = 's3://omni-results'

        params.eggnog_db_dir      = '/mnt/databases/eggnog'
        params.busco_db_path      = '/mnt/databases/busco'
        params.funannotate_db     = '/mnt/databases/funannotate'
        params.dbcan_db           = '/mnt/databases/dbcan'
        params.checkm2_db         = '/mnt/databases/checkm2'
        params.resfinder_db       = '/mnt/databases/resfinder/resfinder_db'
        params.pointfinder_db     = '/mnt/databases/pointfinder/pointfinder_db'
        params.helixer_models_dir = '/mnt/databases/helixer'
        params.nlr_jar            = '/mnt/databases/nlr/NLR-Annotator-v2.1b.jar'
        params.nlr_mot            = '/mnt/databases/nlr/mot.txt'
        params.nlr_store          = '/mnt/databases/nlr/store.txt'

        aws.region       = 'eu-central-1'
        process.executor = 'awsbatch'
    }
}

def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else
                return obj
        } catch (all) {
            println "### ERROR ### Max memory '${params.max_memory}' is not valid! Using default: $obj"
            return obj
        }
    } else if (type == 'cpus') {
        try {
            return Math.min( obj, params.max_cpus as int )
        } catch (all) {
            println "### ERROR ### Max cpus '${params.max_cpus}' is not valid! Using default: $obj"
            return obj
        }
    }
}
