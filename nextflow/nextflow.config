// ~/'OmniDomain/nextflow/nextflow.config
// 'OmniDomain — Unified Cross-Kingdom Genomics Platform
// Global configuration — applies to all pipelines (NextAMR, FungalFlow, phytoflow)
 
manifest {
    name            = 'OmniDomain'
    author          = 'Naouel El Djouher'
    description     = ''
    nextflowVersion = '!>=23.04.0'
    version         = '1.0.0'
    homePage        = 'https://github.com/NaouelEldjouher'
}
 
// ==============================================================================
// 1. GLOBAL PARAMETER DEFAULTS
// ==============================================================================
params {
    // Hardware limits — override per profile
    max_memory = '128.GB'
    max_cpus   = 32
    max_time   = '240.h'
 
    // Output
    outdir     = 'results'
 
    // ── Pipeline mode flags ────────────────────────────────────────────────
    // Set by Streamlit UI — users never set these directly
    // Default: organelle mode — safest default (skips heavy annotation tools)

    run_helixer     = false         // enable deep learning gene prediction
    run_maker       = false         // enable evidence-based gene prediction
    run_comparative = false         // enable OrthoFinder + MCScanX
 
    // ── PhyloFlow inputs ───────────────────────────────────────────────────
    hifi_reads         = null       // PacBio HiFi reads (.fastq.gz) — mandatory
    hic_reads          = null       // Hi-C paired reads — optional scaffolding
    hic_map            = null       // Hi-C alignment map — optional YAHS input
    reference          = null       // Reference genome — optional RagTag scaffolding
    transcriptome      = null       // RNA-seq evidence — optional MAKER input
    proteins           = null       // Protein hints — optional MAKER input
    helixer_models_dir = null       // Path to Helixer model directory
 
    // ── NLR-Annotator assets ───────────────────────────────────────────────
    // Passed as channel inputs — supports local paths and S3 URIs
    nlr_jar   = null
    nlr_mot   = null
    nlr_store = null
 
    // ── FungalFlow inputs ──────────────────────────────────────────────────
    shortreads    = null
    longreads     = null
    rnaseq_bam    = null
    protein_hints = null
    busco_lineage = 'fungi_odb10'    // for FungalFlow
    busco_mode    = 'genome'
 
    // ── Database paths ─────────────────────────────────────────────────────
    // Null = tool downloads at runtime (slow, costs money on AWS)
    // Set to pre-downloaded paths for production runs
    eggnog_db_dir = null
    busco_db      = null
}
 
// ==============================================================================
// 2. GLOBAL PROCESS DEFAULTS
// ==============================================================================
process {
    // Consistent shell across all processes — prevents -ue injection into tools
    // that don't support bash flags (antiSMASH, Helixer, etc.)
    shell = ['/bin/bash', '-eo', 'pipefail']
 
    // Resource labels — all processes must declare one of these labels
    withLabel: 'process_single' {
        cpus   = { check_max( 1,                    'cpus'   ) }
        memory = { check_max( 2.GB  * task.attempt, 'memory' ) }
        time   = { check_max( 4.h   * task.attempt, 'time'   ) }
    }
    withLabel: 'process_low' {
        cpus   = { check_max( 2     * task.attempt, 'cpus'   ) }
        memory = { check_max( 4.GB  * task.attempt, 'memory' ) }
        time   = { check_max( 8.h   * task.attempt, 'time'   ) }
    }
    withLabel: 'process_medium' {
        cpus   = { check_max( 4     * task.attempt, 'cpus'   ) }
        memory = { check_max( 8.GB  * task.attempt, 'memory' ) }
        time   = { check_max( 24.h  * task.attempt, 'time'   ) }
    }
    withLabel: 'process_high' {
        cpus   = { check_max( 4     * task.attempt, 'cpus'   ) }
        memory = { check_max( 16.GB * task.attempt, 'memory' ) }
        time   = { check_max( 72.h  * task.attempt, 'time'   ) }
    }
    withLabel: 'process_very_high' {
        cpus   = { check_max( 16    * task.attempt, 'cpus'   ) }
        memory = { check_max( 64.GB * task.attempt, 'memory' ) }
        time   = { check_max( 120.h * task.attempt, 'time'   ) }
    }
 
    // Auto-retry on OOM — doubles memory on each attempt
    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries    = 2
}
 
// ==============================================================================
// 3. EXECUTION PROFILES
// ==============================================================================
profiles {
 
    // ── Standard Docker execution ────────────────────────────────────────────
    docker {
        docker.enabled       = true
        docker.runOptions    = '-u $(id -u):$(id -g)'
        singularity.enabled  = false
    }
 
    // ── HPC / Singularity execution ──────────────────────────────────────────
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }
 
    // ── PhytoFlow production (Docker) ────────────────────────────────────────
    // Usage: nextflow run nextflow/phytoflow/main.nf -profile eukaryote_env
    eukaryote_env {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        includeConfig 'phytoflow/modules.config'
    }
 
    // ── FungalFlow production (Docker) ───────────────────────────────────────
    // Usage: nextflow run nextflow/fungalflow/main.nf -profile fungal_env
    fungal_env {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        includeConfig 'fungalflow/modules.config'
    }
 
    // ── NextAMR bacterial pipeline (Docker) ──────────────────────────────────
    // Usage: nextflow run nextflow/nextamr/main.nf -profile staphb_amr
    staphb_amr {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        includeConfig 'nextamr/modules.config'
    }
 
    // ── Local development — reduced resources ────────────────────────────────
    // Combine with a pipeline profile:
    //   nextflow run ... -profile eukaryote_env,local_dev
    //   nextflow run ... -profile fungal_env,local_dev
    // DO NOT use alone — no containers defined in this profile
    local_dev {
        params.max_memory = '20.GB'
        params.max_cpus   = 8
        params.max_time   = '24.h'
    }
 
    // ── AWS Batch production ──────────────────────────────────────────────────
    // For deployment with Seqera Platform or manual AWS Batch configuration
    // Combine with pipeline profile: -profile eukaryote_env,aws
    aws {
        params.max_memory = '256.GB'
        params.max_cpus   = 64
        params.max_time   = '720.h'
        aws.region        = 'eu-central-1'
        process.executor  = 'awsbatch'
    }
}
 
// ==============================================================================
// 4. RESOURCE CHECKING FUNCTION
// Ensures process resource requests never exceed global hardware limits
// ==============================================================================
def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else
                return obj
        } catch (all) {
            println "   ### ERROR ###   Max memory '${params.max_memory}' is not valid! Using default value: $obj"
            return obj
        }
    } else if (type == 'cpus') {
        try {
            return Math.min( obj, params.max_cpus as int )
        } catch (all) {
            println "   ### ERROR ###   Max cpus '${params.max_cpus}' is not valid! Using default value: $obj"
            return obj
        }
    }
}