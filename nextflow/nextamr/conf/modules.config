// nextamr/conf/modules.config

process {

    // ==============================================================================
    // 1. CO-ASSEMBLY TRACK CONFIGURATION
    // ==============================================================================
    withName: 'FLYE' {
        ext.args = '--meta'
        publishDir = [ path: { "${params.outdir}/01_co_assembly" }, mode: 'copy', pattern: '*.fasta' ]
    }

    withName: 'MEGAHIT' {
        publishDir = [ path: { "${params.outdir}/01_co_assembly" }, mode: 'copy', pattern: '*.fasta' ]
    }

    // ==============================================================================
    // 2. METAGENOMIC BINNING & QUALITY CONTROL TRACK
    // ==============================================================================
    withName: 'MINIMAP2_ALIGN' {
        publishDir = [ path: { "${params.outdir}/02_binning/alignments" }, mode: 'copy', pattern: '*.sorted.bam*' ]
    }

 

    withName: 'SAMTOOLS_DEPTH' {
        publishDir = [ path: { "${params.outdir}/02_binning/abundance_profiles" }, mode: 'copy' ]
    }

    // FIXED: Must match the alias 'METABAT2' used in your subworkflow
    withName: 'METABAT2' {
        publishDir = [ path: { "${params.outdir}/02_binning/raw_bins" }, mode: 'copy' ]
    }

    // FIXED: Must match the alias 'CHECKM2' used in your subworkflow
    withName: 'CHECKM2' {
        publishDir = [ path: { "${params.outdir}/02_binning/checkm2_reports" }, mode: 'copy' ]
    }

    // ==============================================================================
    // 3. MAG ANNOTATION & FUNCTIONAL PROFILING TRACK
    // ==============================================================================
    withName: 'BAKTA' {
        publishDir = [ path: { "${params.outdir}/03_mag_analysis/annotations" }, mode: 'copy' ]
    }

    withName: 'AMRFINDERPLUS' {
        ext.args = '--plus --nucleotide'
        publishDir = [ path: { "${params.outdir}/03_mag_analysis/resistance_profiles" }, mode: 'copy' ]
    }
}