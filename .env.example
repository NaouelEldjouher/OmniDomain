# =============================================================================
# OmniDomain — Environment Variables
# Copy to .env and fill in values after running terraform apply
#
# Generate automatically:
#   terraform -chdir=terraform output -raw env_template > .env
# =============================================================================

# ── AWS Credentials ───────────────────────────────────────────────────────────
# Get from: terraform output streamlit_access_key_id
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1

# ── S3 Buckets ────────────────────────────────────────────────────────────────
# Get from: terraform output compute_bucket / results_bucket
OMNI_COMPUTE_BUCKET=omni-compute
OMNI_RESULTS_BUCKET=omni-results
OMNI_BASE_OUTDIR=s3://omni-results

# ── AWS Batch ─────────────────────────────────────────────────────────────────
# Get from: terraform output batch_job_queue / batch_job_definition
AWS_BATCH_QUEUE=omni-batch-queue
AWS_BATCH_JOB_DEFINITION=omni-nextflow-job

# ── Database (PostgreSQL on RDS or local SQLite) ──────────────────────────────
# Local dev (SQLite — no setup needed):
#   DATABASE_URL=sqlite:///omniodomain.db
# AWS RDS PostgreSQL:
#   DATABASE_URL=postgresql://omni:PASSWORD@RDS_ENDPOINT:5432/omnidb
DATABASE_URL=sqlite:///omniodomain.db

# ── Tool Database Paths on EFS ────────────────────────────────────────────────
# These are set automatically inside Batch containers via job definition
# Only needed if running Nextflow locally pointing at EFS
OMNI_EGGNOG_DB=/mnt/databases/eggnog
OMNI_DBCAN_DB=/mnt/databases/dbcan
OMNI_FUNANNOTATE_DB=/mnt/databases/funannotate
OMNI_HELIXER_MODEL=/mnt/databases/helixer
OMNI_BUSCO_DB=/mnt/databases/busco
OMNI_NLR_JAR=/mnt/databases/nlr/NLR-Annotator-v2.1b.jar
OMNI_NLR_MOT=/mnt/databases/nlr/mot.txt
OMNI_NLR_STORE=/mnt/databases/nlr/store.txt
